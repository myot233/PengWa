<?xml version="1.0" encoding="utf-8"?>
<!-- requireDeviceUnlock=false：屏幕亮着即可被碰，不必先解锁。
     两个 AID 各放一个 aid-group：组内的 AID 要么全归本服务、要么全不归，分开写互不牵连。 -->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/hce_service_description"
    android:requireDeviceUnlock="false">

    <!-- 私有 AID：F0 + "PENGWA" 的 ASCII，与 ApduProtocol.AID 保持一致。
         两边都装了 App 时一次碰触双向交换名片；对方必须先出示合法名片才会拿到我的名片。 -->
    <aid-group
        android:category="other"
        android:description="@string/hce_aid_group_description">
        <aid-filter android:name="F050454E475741" />
    </aid-group>

    <!-- NFC Forum NDEF 标签应用的标准 AID，与 T4tEmulator.AID 保持一致。
         任何手机都把我们当一张标签来读，系统据此拉起 App；仅在名片页前台时响应（TagShareGate）。 -->
    <aid-group
        android:category="other"
        android:description="@string/hce_tag_group_description">
        <aid-filter android:name="D2760000850101" />
    </aid-group>
</host-apdu-service>
